+#import <objc/runtime.h>
+
+// Recipedia: disables ML Kit telemetry (no public opt-out) via private symbols. See architecture/invariants.md.
+@interface RecipediaMLKitTelemetryDisabler : NSObject
+@end
+
+@implementation RecipediaMLKitTelemetryDisabler
+
++ (void)load {
+    Class uploader = NSClassFromString(@"MLKITx_CCTClearcutUploader");
+    Method startAutoUpload = class_getInstanceMethod(uploader, NSSelectorFromString(@"startAutoUpload"));
+    if (startAutoUpload) {
+        method_setImplementation(startAutoUpload, imp_implementationWithBlock(^(id _self) {}));
+    } else {
+        NSLog(@"[Recipedia] ML Kit Clearcut uploader not found, telemetry may still be active");
+    }
+
+    NSMutableDictionary *statsDisabled = [NSMutableDictionary dictionary];
+    for (NSString *module in @[@"commonDownloader", @"digitalInk", @"linkFirebase", @"mddDownloader",
+                               @"naturalLanguage", @"remoteConfig", @"vision"]) {
+        NSString *key = [NSString stringWithFormat:@"com.google.firebase.ml.%@.__MLKIT_DEFAULT.isStatsCollectionEnabled", module];
+        statsDisabled[key] = @NO;
+    }
+    [NSUserDefaults.standardUserDefaults registerDefaults:statsDisabled];
+}
+
+@end
 
