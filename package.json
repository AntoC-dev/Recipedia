{
  "name": "recipedia",
  "version": "2.58.0",
  "packageManager": "npm@10.9.3",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "dev:clean": "npx expo start --clear",
    "build:test:android": "eas build --local --profile maestro --platform android",
    "build:test:ios": "eas build --local --profile maestro --platform ios",
    "build:prod:android": "eas build --local --profile production --platform android",
    "build:prod:ios": "eas build --local --profile production --platform ios",
    "build:perf:android": "eas build --local --profile performance --platform android",
    "build:perf:ios": "eas build --local --profile performance --platform ios",
    "build:production-maestro:android": "eas build --local --profile production-maestro --platform android",
    "build:production-maestro:ios": "eas build --local --profile production-maestro --platform ios",
    "build:clean": "rm -rf android/app/build ios/build .expo",
    "install:android": "adb install *.apk && rm -f *.apk",
    "install:ios": "xcrun simctl install booted *.app",
    "submit:android": "eas submit --platform android --path ./build-*.aab",
    "submit:ios": "eas submit --platform ios --path ./build-*.ipa",
    "submit:android:latest": "eas submit --platform android --latest",
    "submit:ios:latest": "eas submit --platform ios --latest",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.js tests/unit",
    "test:unit:watch": "jest --watchAll --silent --config jest.config.js tests/unit",
    "test:unit:coverage": "jest --reporters=default --coverage --reporters=jest-junit --config jest.config.js tests/unit",
    "test:unit:fail-only": "jest --silent --onlyFailures --config jest.config.js tests/unit",
    "test:integration": "jest --config jest.config.js tests/integration",
    "boot:ios-simulator": "bash scripts/boot-ios-simulator.sh",
    "workflow:build-test:ios": "npm run build:test:ios && npm run boot:ios-simulator && npm run install:ios",
    "test:perf": "reassure",
    "test:perf:baseline": "reassure --baseline",
    "test:scripts": "node --test .github/scripts/*.test.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit",
    "expo:doctor": "npx expo-doctor",
    "knip:check": "knip --production",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run knip:check && npm run expo:doctor",
    "docs:build": "typedoc",
    "docs:clean": "rm -rf docs/",
    "workflow:build-install::android": "npm run build:test:android && npm run install:android",
    "workflow:quality": "npm run quality && npm run test:unit:coverage",
    "release": "semantic-release",
    "security:audit": "npm audit --audit-level=moderate",
    "prepare": "husky",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "{src,tests}/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-native-ml-kit/text-recognition": "~2.0.0",
    "@react-navigation/bottom-tabs": "~7.18.8",
    "@react-navigation/native": "~7.3.8",
    "@react-navigation/native-stack": "~7.17.10",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-background-task": "~58.0.13",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-mail-composer": "~58.0.4",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "html-entities": "2.6.0",
    "i18next": "^25.5.2",
    "i18next-resources-to-backend": "^1.2.4",
    "minisearch": "7.2.0",
    "numeric-quantity": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.85.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.88.1",
    "react-native-copilot": "3.3.3",
    "react-native-image-crop-picker": "0.51.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-logs": "^5.3.0",
    "react-native-paper": "5.15.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "resolutions": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "undici": "^6.28.0",
    "npm": "^12.0.2",
    "fast-uri": "^4.1.2",
    "zod-validation-error": "^4.0.0",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
    "ip-address@>=10.0.0 <10.5.0": "10.5.0",
    "js-yaml@<4.0.0": "3.15.1",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "nanoid@<3.3.18": "3.3.18",
    "tar@>=7.0.0 <7.5.22": "7.5.22",
    "uuid": "^11.1.1",
    "shell-quote": "^1.12.0",
    "simple-git": "^4.0.2",
    "handlebars": "^4.7.10"
  },
  "private": true,
  "devDependencies": {
    "@babel/preset-env": "~7.28.3",
    "@babel/preset-typescript": "~7.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/jest-preset": "0.88.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.5",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "~30.1.2",
    "babel-plugin-module-resolver": "~5.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "jest-junit": "^16.0.0",
    "knip": "6.42.1",
    "lint-staged": "16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "pyodide": "314.0.7",
    "reassure": "1.6.1",
    "semantic-release": "25.0.9",
    "test-renderer": "1.2.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "varvara-typedoc-theme": "0.3.9"
  }
}
